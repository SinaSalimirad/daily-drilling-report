# Copy to .env and adjust. .env is never committed (docs/11-environments-and-deployment.md).

# api, web
NODE_ENV=development

# api
API_PORT=3001
# Host processes (bun run dev) reach PostgreSQL on localhost; the api container
# gets its own value from docker-compose.yml (host `postgres`).
DATABASE_URL=postgres://ddr:ddr_local_password@localhost:5432/ddr
LOG_LEVEL=info

# postgres
# Port on the host; change it (and DATABASE_URL above) if 5432 is already taken.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=ddr
POSTGRES_PASSWORD=ddr_local_password
POSTGRES_DB=ddr

# nginx — open http://localhost (change the port if 80 is taken)
NGINX_HOST_PORT=80


# --- Authentication (v0.9.0, docs/07) ---------------------------------------------------
# Signs sessions. Required in production (at least 32 random characters).
# BETTER_AUTH_SECRET=
# The origin the browser uses; the only origin accepted for state-changing requests.
# APP_ORIGIN=http://localhost
# First administrator, created by `bun run db:seed:admin` (in apps/api).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# --- PDF (v1.1.0, docs/11) ---------------------------------------------------------------
# Gotenberg renders the print pages. An api on the host reaches the Compose container here;
# the api container uses http://gotenberg:3000 (docker-compose.yml).
# GOTENBERG_URL=http://localhost:3002
# GOTENBERG_HOST_PORT=3002
# Where Gotenberg (inside Docker) opens the pages: nginx.
# PDF_PAGE_ORIGIN=http://nginx
