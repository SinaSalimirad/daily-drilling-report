# Copy to .env and adjust. .env is never committed (docs/11-environments-and-deployment.md).

# api, web
NODE_ENV=development

# api
API_PORT=3001
# Host processes (bun run dev) reach PostgreSQL on localhost; the api container
# gets its own value from docker-compose.yml (host `postgres`).
DATABASE_URL=postgres://ddr:ddr_local_password@localhost:5432/ddr
LOG_LEVEL=info

# postgres
# Port on the host; change it (and DATABASE_URL above) if 5432 is already taken.
POSTGRES_HOST_PORT=5432
POSTGRES_USER=ddr
POSTGRES_PASSWORD=ddr_local_password
POSTGRES_DB=ddr

# nginx — open http://localhost (change the port if 80 is taken)
NGINX_HOST_PORT=80

# web (inlined at build time; keep it relative)
NEXT_PUBLIC_API_BASE=/api
