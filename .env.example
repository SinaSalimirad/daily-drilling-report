POSTGRES_DB=daily_drilling_report
POSTGRES_USER=postgres
POSTGRES_PASSWORD=STRONG_PASSWORD
POSTGRES_HOST_PORT=5432

PORT=4000
DATABASE_URL=postgres://postgres:STRONG_PASSWORD@localhost:5432/daily_drilling_report

# Comma-separated browser origins allowed to call the API directly (empty = no CORS, fine behind nginx)
CORS_ORIGINS=http://localhost:3000

NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Rate limiting (per client IP)
RATE_LIMIT_MAX=100
RATE_LIMIT_WRITE_MAX=20
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_REFRESH_MAX=30

# Signs the access tokens. Required, at least 32 characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_32_OR_MORE_CHARACTERS

# Access token lifetime; also how long a revoked user can keep using one they already hold
ACCESS_TOKEN_TTL_MINUTES=15
# Each refresh gives a new refresh token valid this long ...
REFRESH_TOKEN_TTL_DAYS=14
# ... until this many days after login, then the user logs in again
SESSION_MAX_AGE_DAYS=30
# A used refresh token sent again within this many seconds is a tab race, later it is theft
REFRESH_REUSE_GRACE_SECONDS=10
