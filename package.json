{
  "name": "daily-drilling-report",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "dev:web": "bun --filter",
    "dev:api": "bun --filter",
    "build:web": "bun --filter",
    "build:api": "bun --filter",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun apps/api/src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "drizzle-kit": "^0.31.10",
    "@types/node": "^26.1.2"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun"
}
