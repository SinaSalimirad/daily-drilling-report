{
  "name": "@daily-mud-fluid-report",
  "private": true,
  "version": "0.3.0",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@daily-mud-fluid-report/*' dev",
    "api:dev": "bun run --filter @daily-mud-fluid-report/api dev",
    "web:dev": "bun run --filter @daily-mud-fluid-report/web dev",
    "api:build": "bun run --filter @daily-mud-fluid-report/api build",
    "web:build": "bun run --filter @daily-mud-fluid-report/web build",
    "build": "bun run api:build && bun run web:build",
    "typecheck": "bun run --filter '@daily-mud-fluid-report/*' typecheck",
    "test": "bun run --filter '@daily-mud-fluid-report/*' test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:generate": "bun run --filter @daily-mud-fluid-report/api db:generate",
    "db:migrate": "bun run --filter @daily-mud-fluid-report/api db:migrate",
    "db:studio": "bun run --filter @daily-mud-fluid-report/api db:studio",
    "db:seed": "bun run --filter @daily-mud-fluid-report/api db:seed",
    "db:create-admin": "bun run --filter @daily-mud-fluid-report/api db:create-admin",
    "db:up": "docker compose -f infra/docker/compose.dev.yml --env-file .env up -d postgres",
    "stack:up": "docker compose -f infra/docker/compose.dev.yml --env-file .env up --build",
    "stack:down": "docker compose -f infra/docker/compose.dev.yml --env-file .env down"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "typescript": "7.0.2"
  }
}
