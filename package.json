{
  "name": "daily-drilling-report",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check . --write",
    "web:dev": "bun --filter",
    "api:dev": "bun --filter @daily-drilling-report/api dev",
    "web:build": "bun --filter",
    "api:build": "bun --filter @daily-drilling-report/api build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "bun run apps/api/src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.23.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.10"
  },
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun"
}
