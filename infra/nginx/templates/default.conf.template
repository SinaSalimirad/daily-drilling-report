# DMR Online — one origin for web and API (docs/11-environments-and-deployment.md).
#   /api/  -> api (Elysia, port 3001)
#   /      -> web (Next.js, port 3000)
# Each upstream prefers the Compose container and falls back to the same port on the
# Docker host, so `docker compose up postgres nginx` + `bun run dev` on the host also works.
# Names are re-resolved at runtime (Docker DNS), so Nginx starts even when api/web are down.

resolver 127.0.0.11 valid=5s ipv6=off;

upstream api_upstream {
  zone api_upstream 64k;
  server api:3001 resolve max_fails=0;
  server host.docker.internal:3001 resolve max_fails=0 backup;
}

upstream web_upstream {
  zone web_upstream 64k;
  server web:3000 resolve max_fails=0;
  server host.docker.internal:3000 resolve max_fails=0 backup;
}

# One JSON line per request; request_id equals the API's requestId (docs/06-logging.md).
log_format json escape=json
  '{"time":"$time_iso8601","source":"nginx","requestId":"$request_id",'
  '"method":"$request_method","path":"$uri","status":$status,'
  '"durationMs":$request_time,"upstream":"$upstream_addr","bytes":$body_bytes_sent}';

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      close;
}

server {
  listen 80;
  server_name _;

  access_log /dev/stdout json;
  error_log /dev/stderr warn;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
  server_tokens off;

  add_header X-Content-Type-Options nosniff always;
  add_header Content-Security-Policy "frame-ancestors 'none'" always;

  proxy_http_version 1.1;
  proxy_next_upstream error timeout;

  location /api/ {
    proxy_pass http://api_upstream;
    # proxy_set_header is not inherited once a location sets one, so all are listed here.
    # Every request gets Nginx's id; a client-sent X-Request-Id is replaced.
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  location / {
    proxy_pass http://web_upstream;
    # proxy_set_header is not inherited once a location sets one, so all are listed here.
    # Every request gets Nginx's id; a client-sent X-Request-Id is replaced.
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # WebSocket upgrade for the Next.js dev server (hot reload).
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
  }
}
