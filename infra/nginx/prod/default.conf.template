# DMR Online, production (docs/11-environments-and-deployment.md): HTTPS only. The certificate
# comes from Let's Encrypt (infra/scripts/init-tls.sh the first time, the certbot service after).
# ${DOMAIN} and ${NGINX_CLIENT_MAX_BODY_SIZE} are replaced by nginx's entrypoint from the environment.

resolver 127.0.0.11 valid=5s ipv6=off;

upstream api_upstream {
  zone api_upstream 64k;
  server api:3001 resolve max_fails=0;
}

upstream web_upstream {
  zone web_upstream 64k;
  server web:3000 resolve max_fails=0;
}

log_format json escape=json
  '{"time":"$time_iso8601","source":"nginx","requestId":"$request_id",'
  '"method":"$request_method","path":"$uri","status":$status,'
  '"durationS":$request_time,"upstream":"$upstream_addr","bytes":$body_bytes_sent}';

server {
  listen 80;
  server_name ${DOMAIN};
  access_log /dev/stdout json;

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  access_log /dev/stdout json;
  error_log /dev/stderr warn;

  client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};
  server_tokens off;

  # Security headers (docs/07 checklist).
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Content-Security-Policy "frame-ancestors 'none'" always;
  add_header Referrer-Policy same-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;

  proxy_http_version 1.1;
  proxy_next_upstream error timeout;

  location /api/ {
    proxy_pass http://api_upstream;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
  }

  location / {
    proxy_pass http://web_upstream;
    proxy_set_header X-Request-Id $request_id;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }
}
