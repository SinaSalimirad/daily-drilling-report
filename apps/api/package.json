{
  "name": "@daily-mud-fluid-report/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run --env-file=../../.env drizzle-kit migrate",
    "db:studio": "bun run --env-file=../../.env drizzle-kit studio",
    "db:seed": "bun run --env-file=../../.env src/db/seed.ts",
    "db:create-admin": "bun run --env-file=../../.env src/db/create-admin.ts"
  },
  "dependencies": {
    "@elysia/cors": "^1.4.3",
    "@elysia/openapi": "^1.4.16",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "elysia": "^1.4.30",
    "elysia-rate-limit": "^4.6.3",
    "jose": "6.2.14",
    "logixlysia": "^6.10.4",
    "pg": "^8.23.1",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "bun-types": "^1.3.14",
    "drizzle-kit": "^0.31.11"
  }
}
