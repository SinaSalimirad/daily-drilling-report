{
  "name": "@ddr/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "typecheck": "tsc --noEmit -p .",
    "build": "bun build src/index.ts --target bun --outdir dist",
    "db:generate": "bun --env-file=../../.env --bun x drizzle-kit generate",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "db:seed:lookups": "bun --env-file=../../.env src/db/seed/lookups.ts",
    "db:seed:demo": "bun --env-file=../../.env src/db/seed/demo.ts",
    "db:seed:admin": "bun --env-file=../../.env src/db/seed/admin.ts"
  },
  "dependencies": {
    "@ddr/calc": "workspace:*",
    "@ddr/schemas": "workspace:*",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "elysia": "^1.4.32",
    "logixlysia": "^6.12.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
